# Persona Studio SaaS - Environment Variables for Vast.ai
# Copy this to .env and fill in your values

# JWT Secret - Generate a random string: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-secret

# Engine URL (leave as localhost for full-stack deployment)
PERSONA_ENGINE_URL=http://localhost:6967

# Crypto Wallet (for receiving payments)
CRYPTO_WALLET_ADDRESS=
TRON_API_KEY=
ETH_API_KEY=

# Vast.ai (configured via admin panel, not needed here)
VAST_API_KEY=
